{
  "name": "muscle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify:supabase": "NODE_USE_ENV_PROXY=1 node scripts/verify-supabase.mjs",
    "inspect:db": "NODE_USE_ENV_PROXY=1 node scripts/inspect-db.mjs",
    "verify:rls": "NODE_USE_ENV_PROXY=1 node scripts/verify-rls-crud.mjs",
    "verify:rls:cleanup": "NODE_USE_ENV_PROXY=1 node scripts/verify-rls-crud.mjs --cleanup",
    "test:browser": "NODE_USE_ENV_PROXY=1 playwright test",
    "inspect:rls": "NODE_USE_ENV_PROXY=1 node scripts/inspect-rls.mjs",
    "verify:phase2:cleanup": "NODE_USE_ENV_PROXY=1 node scripts/cleanup-phase2.mjs",
    "test:sql:phase3": "vitest run tests/sql/phase3-atomic.test.ts",
    "test:browser:phase3:local": "NODE_USE_ENV_PROXY=1 playwright test tests/browser/phase3.spec.ts",
    "test:browser:phase1": "NODE_USE_ENV_PROXY=1 playwright test tests/browser/phase1.spec.ts",
    "check:phase3:rpcs": "NODE_USE_ENV_PROXY=1 node scripts/check-phase3-rpcs.mjs",
    "verify:phase3:live": "NODE_USE_ENV_PROXY=1 node scripts/verify-phase3-live.mjs",
    "verify:phase3:cleanup": "NODE_USE_ENV_PROXY=1 node scripts/verify-phase3-live.mjs --cleanup"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
